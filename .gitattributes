# index.html is GENERATED by Eleventy (npm run build) from src/. Pin it to LF so the
# checked-in output matches the build byte for byte on every machine. Without this,
# core.autocrlf (set to true in this repo's config) rewrites the file on checkout and
# every build then reports a whole-file diff that is only line endings.
/index.html  text eol=lf