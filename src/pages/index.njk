---
permalink: "/index.html"
title: Global Peace Yes — 1 billion "yes"
description: Join the journey to one billion people voting yes for global peace. Your verified vote supports Ministries and Departments of Peace in governments worldwide.
---
{% extends "base.njk" %}
{% block tail %}
    <script>
      fetch("{{ site.voteCountApi }}")
        .then(function (r) {
          return r.json();
        })
        .then(function (d) {
          if (typeof d.total_votes !== "number") return;
          document.querySelectorAll("[data-vote-count]").forEach(function (el) {
            el.textContent = d.total_votes.toLocaleString("en-US");
          });
        })
        .catch(function () {});
    </script>
{% endblock %}
{% block main %}
      <section class="hero">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-bleed" aria-hidden="true">
          <img src="assets/images/ZMsciS9yg5LfNfcSiRoSKLJgGQg.svg" alt="" />
        </div>
        <div class="hero-bleed hero-bleed--right" aria-hidden="true">
          <img src="assets/images/ABKMigXujN11Nyj2d5t26iNDfM.svg" alt="" />
        </div>

        <div class="container">
          <div class="hero-video-box">
            <video
              class="hero-video"
              src="assets/video/HYil4OrMpsLcrm3BjW07RwPk.mp4"
              poster="assets/images/CziFiS8dVzF5EdHFUcGpkgtc4.jpg"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Global Peace Yes film"
            ></video>
          </div>

          <p class="eyebrow hero-title">join the journey to</p>

          <svg
            class="hero-display"
            viewBox="0 0 1136 164"
            aria-labelledby="hero-h1"
          >
            <foreignObject width="100%" height="100%">
              <h1 id="hero-h1">1 billion “yes”</h1>
            </foreignObject>
          </svg>

          <div class="hero-lower">
            <div class="vote">
              <p class="vote-count" data-vote-count>166</p>
              <p class="vote-label">
                <span>Current Votes</span
                ><span class="vote-icon" aria-hidden="true"
                  ><i class="vote-icon__ring"></i><i class="vote-icon__dot"></i
                ></span>
              </p>
              <a
                class="btn"
                href="{{ site.voteUrl }}"
                target="_blank"
                rel="noopener"
                >Vote Now</a
              >
            </div>

            <div class="cluster" aria-hidden="true">
              <img
                class="cluster-art"
                src="assets/images/UpOj5WGFLKIccSrXIE82n9LWE.svg"
                alt=""
              />
              <ul class="cluster-icons">
                <li class="cluster-icon">
                  <img
                    src="assets/images/tCijvMlW3XaUnvCQO4xm8kRmZ8.png"
                    alt=""
                  />
                </li>
                <li class="cluster-icon">
                  <img
                    src="assets/images/p6HAczgH0wG6HYD1GTW29qi8o2Q.png"
                    alt=""
                  />
                </li>
                <li class="cluster-icon">
                  <img
                    src="assets/images/VokWKIMEqXGKrrdlG0E7GcA4.png"
                    alt=""
                  />
                </li>
              </ul>
              <ul class="cluster-icons cluster-icons--right">
                <li class="cluster-icon">
                  <img
                    src="assets/images/UONE2wypzkVqXpcKsWZiFpkeIu4.png"
                    alt=""
                  />
                </li>
                <li class="cluster-icon">
                  <img
                    src="assets/images/04VVgoZ9xwO28SnSOqmiBhwN8xU.png"
                    alt=""
                  />
                </li>
                <li class="cluster-icon">
                  <img
                    src="assets/images/U7qiMxdZZBkKPIIRgUmbd3feY4s.png"
                    alt=""
                  />
                </li>
              </ul>
              <video
                class="cluster-video"
                src="{{ site.clusterVideoUrl }}"
                poster="assets/images/dyMS6rdR2pOVe3cU2QkkY5QCHrI.png"
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                aria-label="Global Peace Legacy Vision"
              ></video>
            </div>
          </div>
        </div>
      </section>

      <section class="welcome">
        <div class="container">
          <h2>WELCOME TO <br />GLOBAL PEACE YES</h2>
          <p>
            We warmly invite you to begin your uplifting journey to greater
            peace and well-being by casting your Verified Vote YES for Global
            Peace and downloading our empowering
            <a
              class="link"
              href="{{ site.appStoreUrl }}"
              target="_blank"
              rel="noopener"
              >Peace Champion App</a
            >
          </p>
          <p>
            Your vote supports the creation of Ministries and Departments of
            Peace in governments worldwide, designed to resolve conflict and
            strengthen the Culture of Peace for the betterment of humankind.
          </p>
        </div>
      </section>

      <section class="declaration">
        <div class="container">
          <div class="declaration-grid">
            <div class="embed">
              <iframe
                src="{{ site.declarationEmbed }}"
                title="Declaration for Global Peace"
                loading="lazy"
                allow="autoplay; fullscreen; picture-in-picture"
              ></iframe>
            </div>
            <div class="declaration-copy">
              <h2>“yes” urges for peace focus within governments</h2>
              <p>
                Become the Peace Champion our world needs by joining our
                world-changing movement to reach ONE BILLION verified votes
                cast.
              </p>
              <p>
                All verified votes are registered anonymously and will work
                together en masse as a single, unified voice to endorse and
                activate The Declaration for Global Peace.
              </p>
              <a class="btn">Read the Declaration</a>
            </div>
          </div>
          <p class="declaration-note">
            <svg
              viewBox="0 0 20 21"
              width="20"
              height="21"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M9.99984 13.8332V10.4998M9.99984 7.1665H10.0082M18.3332 10.4998C18.3332 15.1022 14.6022 18.8332 9.99984 18.8332C5.39746 18.8332 1.6665 15.1022 1.6665 10.4998C1.6665 5.89746 5.39746 2.1665 9.99984 2.1665C14.6022 2.1665 18.3332 5.89746 18.3332 10.4998Z"
                stroke="#1A1A1A"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path></svg
            ><span
              >Votes to establish Peace Departments planned to be shared with
              governments starting 2026</span
            >
          </p>
        </div>
      </section>

      <section class="change container">
        <div class="change-grid">
          <h3>be the change</h3>
          <div class="change-copy">
            <p>
              Our world faces immense challenges — wars, climate change and much
              more. It can feel overwhelming to know where to start. Yet these
              issues are interconnected, and progress begins when we prioritize
              peace: inner, interpersonal, international, and harmony with
              nature. By voting for global peace, you not only express its value
              in your life but also contribute to a Declaration for Peace urging
              governments to act. Then you can join a global community with
              opportunities to connect at positive peace events.
            </p>
            <p>
              Be part of the journey to one billion people voting yes for global
              peace — for yourself and for the world.
            </p>
          </div>
        </div>

        <div class="embed">
          <iframe
            src="{{ site.legacyEmbed }}"
            title="Global Peace Legacy Vision"
            loading="lazy"
            allow="autoplay; fullscreen; picture-in-picture"
          ></iframe>
        </div>

        <div class="section-label">
          <p class="label-title">Global Peace Legacy Vision</p>
          <p class="label-sub">Future Generations Prayer</p>
        </div>
      </section>

      <section class="slides container">
        <div class="slide slide--crisis">
          <div class="slide-copy">
            <p class="eyebrow">you can feel it</p>
            <h2>it’s right outside your door</h2>
            <p>
              We’re facing multiple global crises simultaneously, risking
              irreversible damage if we don’t act now. Solving them all at once
              may seem impossible, but as a society, we need a collective
              solution to drive meaningful change.
            </p>
          </div>
          <div class="slide-panel">
            <ul class="cards">
              <li class="card" data-bar="1">
                <h3>Wars Between Nations</h3>
                <p>
                  Devastate civilian populations, destroy critical
                  infrastructure, and create lasting geopolitical instability.
                </p>
              </li>
              <li class="card" data-bar="2">
                <h3>Destruction Of Nature</h3>
                <p>
                  Species extinctions, disrupts ecosystems, and causes damage to
                  the planet's habitability.
                </p>
              </li>
              <li class="card" data-bar="3">
                <h3>Economic Inequity</h3>
                <p>Entrenches poverty and destabilizes societies.</p>
              </li>
              <li class="card" data-bar="4">
                <h3>Mental Health Disorders</h3>
                <p>
                  Drive suicide and domestic violence, strain the health and
                  justice systems, harm individuals and communities.
                </p>
              </li>
              <li class="card card--more" data-bar="5">
                <p>And many more...</p>
              </li>
            </ul>
          </div>
        </div>

        <div class="slide slide--solution">
          <div class="slide-copy">
            <p class="eyebrow">solving the poly-crisis</p>
            <h2>Global peace is the resolution</h2>
            <p>
              All of these crises are interconnected — they’re all about ‘us’
              versus something else. Through global peace, and coming together
              as ‘we,’ these challenges become opportunities for progress.
            </p>
          </div>
          <div class="slide-panel">
            <ul class="cards">
              <li class="card" data-bar="1">
                <h3>Peace Between Nations</h3>
                <p>
                  Protects civilian populations, sustains vital infrastructure,
                  and promotes a stable and interconnected global community.
                </p>
              </li>
              <li class="card" data-bar="2">
                <h3>Environmental Stewardship</h3>
                <p>
                  Preserves coastal cities, supports thriving ecosystems, and
                  ensures the planet remains habitable for future generations.
                </p>
              </li>
              <li class="card" data-bar="3">
                <h3>Broadened Economic Opportunity</h3>
                <p>Reduces poverty and harmonizes societies.</p>
              </li>
              <li class="card" data-bar="4">
                <h3>Mental Health Support</h3>
                <p>
                  Saves lives, strengthens health and justice systems to create
                  greater positive impacts on individuals and communities, and
                  fosters overall well-being.
                </p>
              </li>
              <li class="card card--more" data-bar="5">
                <p>And many more...</p>
              </li>
            </ul>
          </div>
        </div>

        <div class="slide slide--voice">
          <div class="slide-copy">
            <p class="eyebrow">your voice adds up</p>
            <h2>global peace begins with “yes"</h2>
            <p>
              It’s a humongous concept — yet more fathomable than it seems.
              Each ‘yes’ powerfully adds up to the prerequisite collective
              intention for a way of living life more peacefully, and shows our
              political representatives the reasons why to make the same changes
              within our governments.
            </p>
          </div>
          <div class="slide-panel">
            <div class="taglines">
              <p class="tagline">
                <span>global peace</span><span>&mdash; massive goal</span>
              </p>
              <p class="tagline">
                <span>saying &lsquo;yes&rsquo;</span><span>&mdash; easy</span>
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="cta container">
        <h2>Vote yes for global peace</h2>
        <a
          class="btn"
          href="{{ site.voteUrl }}"
          target="_blank"
          rel="noopener"
          >Vote Now</a
        >
      </section>
{% endblock %}
