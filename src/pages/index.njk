{% extends "base.njk" %}
{% block tail %}
    <script>
      fetch("{{ site.voteCountApi }}")
        .then(function (r) {
          return r.json();
        })
        .then(function (d) {
          if (typeof d.total_votes !== "number") return;
          document.querySelectorAll("[data-vote-count]").forEach(function (el) {
            el.textContent = d.total_votes.toLocaleString("en-US");
          });
        })
        .catch(function () {});
    </script>
    <script>
      (function () {
        var carousel = document.querySelector(".carousel");
        if (!carousel) return;
        var slides = Array.prototype.slice.call(
          carousel.querySelectorAll(".carousel__slide"),
        );
        var dots = Array.prototype.slice.call(
          carousel.querySelectorAll("[data-carousel-go]"),
        );
        var status = carousel.querySelector("[data-carousel-status]");
        var previous = carousel.querySelector("[data-carousel-prev]");
        var next = carousel.querySelector("[data-carousel-next]");
        var current = 0;
        if (!slides.length || !previous || !next) return;

        function showSlide(index) {
          current = (index + slides.length) % slides.length;
          slides.forEach(function (slide, i) {
            slide.hidden = i !== current;
          });
          dots.forEach(function (dot, i) {
            dot.setAttribute("aria-pressed", String(i === current));
          });
          if (status) {
            status.textContent = "Slide " + (current + 1) + " of " + slides.length;
          }
        }

        previous.addEventListener("click", function () {
          showSlide(current - 1);
        });
        next.addEventListener("click", function () {
          showSlide(current + 1);
        });
        dots.forEach(function (dot) {
          dot.addEventListener("click", function () {
            showSlide(Number(dot.getAttribute("data-carousel-go")));
          });
        });
      })();
    </script>
{% endblock %}
