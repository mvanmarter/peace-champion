    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__cta">
          <h2>Vote yes for global peace</h2>
          <a class="btn" href="{{ site.voteUrl }}" target="_blank" rel="noopener">Vote Now</a>
        </div>
        <svg
          class="footer-rule"
          viewBox="0 0 1154 4"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <use href="{{ site.sprite }}#{{ site.footerRule }}"></use>
        </svg>
        <div class="site-footer__row">
          <ul class="footer-links">
          {%- for group in nav.footerGroups %}
            <li>
            {%- for id in group.links %}
              {%- set item = nav.byId[id] %}
              <a href="{{ item.href }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
            {%- endfor %}
            {%- if group.social %}
              <div class="footer-social">
              {%- for id in group.social %}
                {%- set s = nav.byId[id] %}
                <a href="{{ s.href }}"{% if s.external %} target="_blank" rel="noopener"{% endif %} aria-label="{{ s.label }}">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ s.icon | safe }}</svg>
                </a>
              {%- endfor %}
              </div>
            {%- endif %}
            </li>
          {%- endfor %}
          </ul>
          <div class="footer-brand">
            <svg class="footer-logo" viewBox="0 0 127 33" aria-hidden="true" focusable="false">
              <use href="{{ site.sprite }}#{{ site.footerSymbol }}"></use>
            </svg>
            <p class="footer-copy">&copy; 2026 Global Peace Yes, Inc. All Rights Reserved.</p>
          </div>
        </div>
      </div>
    </footer>
